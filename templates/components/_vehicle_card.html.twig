<article class="vehicle-card">
    {% set photos = vehicule.photosTriees %}
    {% if photos|length > 0 %}
        <picture>
            <source srcset="{{ path('photo_vehicule', {id: photos[0].id, variante: 'vignette', format: 'webp'}) }} 480w, {{ path('photo_vehicule', {id: photos[0].id, variante: 'carte', format: 'webp'}) }} 800w" sizes="(min-width: 1024px) 33vw, 100vw" type="image/webp">
            <source srcset="{{ path('photo_vehicule', {id: photos[0].id, variante: 'vignette', format: 'jpg'}) }} 480w, {{ path('photo_vehicule', {id: photos[0].id, variante: 'carte', format: 'jpg'}) }} 800w" sizes="(min-width: 1024px) 33vw, 100vw" type="image/jpeg">
            <img class="vehicle-card__media" src="{{ path('photo_vehicule', {id: photos[0].id, variante: 'carte', format: 'jpg'}) }}" alt="{{ photos[0].texteAlternatif }}" width="800" height="600" loading="lazy" decoding="async">
        </picture>
    {% else %}
        <div class="vehicle-card__placeholder" aria-label="Photo non disponible">Photo à venir</div>
    {% endif %}
    <div class="vehicle-card__body">
        <p class="small text-body-secondary mb-1">Réf. {{ vehicule.reference }}</p>
        <h2 class="h5">{{ vehicule.titre }}</h2>
        <p class="mb-2">{{ vehicule.misEnCirculationLe|date('Y') }} · {{ vehicule.kilometrage|number_format(0, ',', ' ') }} km<br>{{ vehicule.energie.value|capitalize }} · {{ vehicule.boite.value|capitalize }}</p>
        {% if vehicule.prix %}<p class="vehicle-card__price mb-2">{{ vehicule.prix|number_format(0, ',', ' ') }} €</p>{% endif %}
        <a class="vehicle-card__link fw-bold" href="{{ path('vehicule_detail', {reference: vehicule.reference}) }}">Voir la fiche</a>
    </div>
</article>
