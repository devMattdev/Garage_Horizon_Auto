<nav class="breadcrumb container" aria-label="Fil d’Ariane"><ol>{% for item in items %}<li>{% if item.url is defined %}<a href="{{ item.url }}">{{ item.label }}</a>{% else %}<span aria-current="page">{{ item.label }}</span>{% endif %}</li>{% endfor %}</ol></nav>
<script type="application/ld+json" nonce="{{ csp_nonce('script') }}">{{ {'@context': 'https://schema.org', '@type': 'BreadcrumbList', 'itemListElement': items|map((item, index) => {'@type': 'ListItem', 'position': index + 1, 'name': item.label, 'item': item.url|default(app.request.uri)})}|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
