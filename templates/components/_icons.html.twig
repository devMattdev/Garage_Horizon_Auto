{% macro svg(name, class) %}
    {%- set common = 'width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"' -%}
    {%- if name == 'check' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M4 12.5l4.5 4.5L20 6"/></svg>
    {%- elseif name == 'phone' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M6.5 3h3l1.3 3.8-2 1.6a11 11 0 0 0 5.8 5.8l1.6-2 3.8 1.3v3c0 1-.9 1.8-1.9 1.7C10.5 17.6 6.4 13.5 5.8 6.9 5.7 5.9 6.5 3 6.5 3z"/></svg>
    {%- elseif name == 'mail' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
    {%- elseif name == 'pin' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 21s7-6.7 7-12a7 7 0 1 0-14 0c0 5.3 7 12 7 12z"/><circle cx="12" cy="9" r="2.3"/></svg>
    {%- elseif name == 'clock' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.2 2"/></svg>
    {%- elseif name == 'oil' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 3c3 4.2 6 7.8 6 11.2a6 6 0 1 1-12 0C6 10.8 9 7.2 12 3z"/></svg>
    {%- elseif name == 'wrench' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M14.7 3.3a4.7 4.7 0 0 0-5.9 5.7L3 15v3.5a1.5 1.5 0 0 0 1.5 1.5H8l6-6a4.7 4.7 0 0 0 5.7-5.9l-3 3-2.3-2.3 3-3z"/></svg>
    {%- elseif name == 'tire' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="2.6"/><path d="M12 4v3M12 17v3M4 12h3M17 12h3M6.5 6.5l2 2M15.5 15.5l2 2M17.5 6.5l-2 2M8.3 15.7l-2 2"/></svg>
    {%- elseif name == 'snow' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 2v20M4.7 6l14.6 12M19.3 6L4.7 18"/></svg>
    {%- elseif name == 'scan' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M4 8.5V6a1.5 1.5 0 0 1 1.5-1.5H8M20 8.5V6A1.5 1.5 0 0 0 18.5 4.5H16M4 15.5V18A1.5 1.5 0 0 0 5.5 19.5H8M20 15.5V18a1.5 1.5 0 0 1-1.5 1.5H16"/><path d="M4 12h16"/></svg>
    {%- elseif name == 'people' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="8.2" cy="8" r="3"/><path d="M2.5 20c0-3.4 2.5-6 5.7-6s5.7 2.6 5.7 6"/><circle cx="17" cy="9" r="2.3"/><path d="M14.8 14.3c2.5.4 4.7 2.5 5.1 5.7"/></svg>
    {%- elseif name == 'badge' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="12" cy="8" r="5"/><path d="M9 12.3L7 21l5-2.6L17 21l-2-8.7"/></svg>
    {%- elseif name == 'shield' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 3l7 3v5.5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6l7-3z"/><path d="M9 12l2 2 4-4.5"/></svg>
    {%- elseif name == 'document' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
    {%- elseif name == 'calendar' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><rect x="3.5" y="4.5" width="17" height="16" rx="2"/><path d="M3.5 9.5h17M8 2.5v4M16 2.5v4"/></svg>
    {%- elseif name == 'chevron-right' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M9 5l7 7-7 7"/></svg>
    {%- elseif name == 'home-oil' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M3 9h12l2.2 2.2H21v4.2h-3.5l-2.2 2.1H6.2L3 14.4z"/><path d="M6 9V6h5v3M2 12H.8M19 7.5h3"/><path d="M21.5 16.2c0 1.1-.8 1.8-1.7 1.8s-1.7-.7-1.7-1.8c0-.9 1.7-3 1.7-3s1.7 2.1 1.7 3z"/></svg>
    {%- elseif name == 'home-distribution' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="8"/><path d="M12 1v3M12 20v3M1 12h3M20 12h3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M19.8 4.2l-2.1 2.1M6.3 17.7l-2.1 2.1"/><circle cx="12" cy="12" r="1"/></svg>
    {%- elseif name == 'home-brake' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="3.2"/><path d="M12 3.5v5.3M12 15.2v5.3M3.5 12h5.3M15.2 12h5.3M6 6l3.7 3.7M14.3 14.3L18 18"/><path d="M18.5 7.2c1.2 1.5 1.8 3 1.9 4.8"/></svg>
    {%- elseif name == 'home-tire' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><ellipse cx="12" cy="12" rx="6.2" ry="10"/><ellipse cx="12" cy="12" rx="3.1" ry="8"/><path d="M9.4 4.8h5.2M8.9 8.4h6.2M8.9 12h6.2M8.9 15.6h6.2M9.4 19.2h5.2"/></svg>
    {%- elseif name == 'home-snow' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 1v22M2.5 6.5l19 11M21.5 6.5l-19 11M9 3l3 3 3-3M9 21l3-3 3 3M3.2 10.2l4.1-1.1-1.1-4.1M20.8 13.8l-4.1 1.1 1.1 4.1M20.8 10.2l-4.1-1.1 1.1-4.1M3.2 13.8l4.1 1.1-1.1 4.1"/></svg>
    {%- elseif name == 'home-engine' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M5 8h11l2 2h3v7h-3l-2 2H7l-2-3H2v-6h3z"/><path d="M8 8V5h6v3M9 12h5M11.5 10v4M21 12h2M2 12H.5"/></svg>
    {%- elseif name == 'search' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.3 15.3L21 21"/></svg>
    {%- elseif name == 'vehicle' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M4 15V9l2-4h12l2 4v6"/><path d="M3 11h18M6 15v3M18 15v3M6.5 12.5h.1M17.5 12.5h.1"/></svg>
    {%- elseif name == 'battery' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M7 7V4h3v3M15 7V4h3v3M8 13h4M10 11v4M15 13h3"/></svg>
    {%- elseif name == 'thumb' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M7 21H3V10h4M7 19c3 1.3 5.5 2 8.5 2 1 0 1.8-.7 2-1.6l2-8C19.8 10.2 19 9 17.7 9H14l.6-3.3C14.9 4 13.6 2 12 2l-5 8v9z"/></svg>
    {%- elseif name == 'swap' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M4 7h15M16 4l3 3-3 3M20 17H5M8 20l-3-3 3-3"/></svg>
    {%- elseif name == 'leaf' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M20 4C11 4 5 8 5 14c0 3 2 5 5 5 6 0 10-6 10-15z"/><path d="M4 21c2-5 6-8 12-11"/></svg>
    {%- elseif name == 'star' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M12 2.5l3 6 6.5.9-4.7 4.6 1.1 6.5-5.9-3.1-5.9 3.1 1.1-6.5-4.7-4.6L9 8.5z"/></svg>
    {%- elseif name == 'facebook' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><path d="M14 21v-7h2.5l.5-3H14V9.2c0-.9.3-1.7 1.7-1.7H17V4.9c-.3 0-1.3-.1-2.4-.1-2.4 0-3.9 1.4-3.9 4.1V11H8v3h2.7v7"/></svg>
    {%- elseif name == 'instagram' -%}
        <svg class="icon {{ class }}" {{ common|raw }}><rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" stroke="none"/></svg>
    {%- endif -%}
{% endmacro %}
