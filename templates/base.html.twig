<!DOCTYPE html>
<html lang="fr">
    <head>
        {% set site = parametres_site() %}
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ site.raisonSociale ?: 'Horizon Auto' }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Garage automobile à {{ site.ville ?: 'Poissy' }} : entretien, mécanique et véhicules d’occasion.{% endblock %}">
        <meta name="theme-color" content="#123f52">
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/logo/favicon-32.png') }}">
        <link rel="icon" type="image/png" sizes="48x48" href="{{ asset('images/logo/favicon-48.png') }}">
        {% block robots %}<meta name="robots" content="index,follow">{% endblock %}
        {% block stylesheets %}<link rel="stylesheet" href="{{ asset('styles/app.scss') }}">{% endblock %}
        {% block structured_data %}{% endblock %}
        {% block javascripts %}{{ importmap('app', {nonce: csp_nonce('script')}) }}{% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {% include 'partials/_utility_bar.html.twig' %}
        {% include 'partials/_banner.html.twig' %}
        {% include 'partials/_header.html.twig' %}
        <main id="contenu" tabindex="-1">
            {% if app.request.hasPreviousSession %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}<div class="container mt-3"><div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }}" role="status">{{ message }}</div></div>{% endfor %}
                {% endfor %}
            {% endif %}
            {% block body %}{% endblock %}
        </main>
        {% include 'partials/_footer.html.twig' %}
        {% include 'partials/_mobile_actions.html.twig' %}
    </body>
</html>
