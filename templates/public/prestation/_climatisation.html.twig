{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
<header class="mechanic-hero"><img src="{{ asset('images/img-climatisation/hero-climatisation.png') }}" alt="" width="2172" height="724" loading="eager" fetchpriority="high"><div class="mechanic-hero__shade" aria-hidden="true"></div><div class="container mechanic-hero__content">
<nav class="mechanic-breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li aria-current="page">Climatisation</li></ol></nav><h1>Climatisation</h1><p>Un habitacle confortable en toutes saisons.<br><small>Entretien, recharge et réparation de votre système de climatisation<br>pour un air plus sain et un confort optimal.</small></p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div>
</div></header>
<main class="mechanic-page climate-page"><div class="container">
<section class="tire-benefits" aria-label="Nos engagements climatisation">{% for item in [{icon: 'home-snow', title: 'Confort toute l’année', text: 'Une température idéale en été comme en hiver'}, {icon: 'check', title: 'Air plus sain', text: 'Filtration des pollens et impuretés'}, {icon: 'home-distribution', title: 'Techniciens qualifiés', text: 'Matériel de diagnostic professionnel'}, {icon: 'badge', title: 'Tarifs transparents', text: 'Devis clair avant intervention'}, {icon: 'clock', title: 'Rendez-vous rapide', text: 'Créneaux disponibles en ligne'}, {icon: 'shield', title: 'Véhicules toutes marques', text: 'Compatibilité essence, diesel, hybride et électrique'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</section>
<section class="tire-services" aria-labelledby="services-clim"><div class="tire-section-title"><h2 id="services-clim">Nos prestations climatisation</h2></div><div class="mechanic-services">{% for card in [{title: 'Recharge de climatisation', text: 'Remise à niveau du gaz et contrôle du circuit', price: 'À partir de 79 €'}, {title: 'Remplacement filtre habitacle', text: 'Un air plus sain dans l’habitacle', price: 'À partir de 39 €'}, {title: 'Diagnostic de fuite', text: 'Recherche de fuite et contrôle d’étanchéité', price: 'À partir de 49 €'}, {title: 'Réparation de climatisation', text: 'Compresseur, condenseur, détendeur, etc.', price: 'Sur devis'}, {title: 'Désinfection du circuit', text: 'Élimination des bactéries et mauvaises odeurs', price: 'À partir de 39 €'}, {title: 'Contrôle de performance', text: 'Vérification complète du système', price: 'À partir de 29 €'}] %}<article class="mechanic-card"><div class="mechanic-card__photo climate-card__photo climate-card__photo--{{ loop.index }}" role="img" aria-label="{{ card.title }}"></div><h3>{{ card.title }}</h3><p>{{ card.text }}</p><div><strong>{{ card.price }}</strong><a href="{{ path('rendez_vous') }}" aria-label="Demander un rendez-vous pour {{ card.title }}">{{ icons.svg('chevron-right') }}</a></div></article>{% endfor %}</div></section>
<div class="row g-4 tire-lower"><div class="col-lg-8">
<section class="climate-benefits" aria-labelledby="pourquoi-clim"><h2 id="pourquoi-clim">Pourquoi entretenir sa climatisation&nbsp;?</h2><div>{% for item in [{icon: 'home-distribution', title: 'Prolonge la durée de vie', text: 'Évite les pannes coûteuses'}, {icon: 'shield', title: 'Améliore la qualité de l’air', text: 'Réduit les bactéries et allergènes'}, {icon: 'check', title: 'Maintient les performances', text: 'Un refroidissement efficace'}, {icon: 'badge', title: 'Limite la consommation', text: 'Un système bien entretenu consomme moins'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</div></section>
<section class="mechanic-faq" aria-labelledby="faq-clim"><h2 id="faq-clim">Questions fréquentes</h2>{% for item in [{q: 'Quand faut-il recharger la climatisation ?', a: 'Un contrôle est conseillé lorsque le système refroidit moins bien ou selon les préconisations du constructeur.'}, {q: 'Combien de temps dure une intervention ?', a: 'Une recharge avec contrôle prend généralement entre une et deux heures.'}, {q: 'Quel type de gaz est utilisé ?', a: 'Le gaz dépend du véhicule. Nous vérifions sa compatibilité avant intervention.'}, {q: 'Le remplacement du filtre habitacle est-il nécessaire ?', a: 'Oui, il contribue à la qualité de l’air et au bon débit de ventilation.'}, {q: 'Puis-je faire désinfecter ma climatisation ?', a: 'Oui, une désinfection aide à supprimer bactéries et mauvaises odeurs.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section>
</div><aside class="col-lg-4"><div class="mechanic-contact"><h2>{{ icons.svg('clock') }} Horaires d’ouverture</h2>{% for groupe in horaires_groupes() %}<div class="mechanic-contact__hours"><span>{{ groupe.jours }}</span><strong>{{ groupe.horaires }}</strong></div>{% endfor %}<a class="btn btn-primary w-100" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-primary w-100" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}{% if site.adresse %}<p class="mechanic-contact__address">{{ icons.svg('pin') }} <span>{{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Voir l’itinéraire</a>{% endif %}</span></p>{% endif %}<div class="climate-help">{{ icons.svg('home-snow') }}<p><strong>Un doute sur votre climatisation&nbsp;?</strong><br>Nos experts vous conseillent gratuitement.</p></div></div></aside></div>
</div></main>
