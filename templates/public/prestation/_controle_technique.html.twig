{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
<header class="mechanic-hero"><img src="{{ asset('images/img-controle-technique/hero-controle-technique.png') }}" alt="" width="2164" height="727" loading="eager" fetchpriority="high"><div class="mechanic-hero__shade" aria-hidden="true"></div><div class="container mechanic-hero__content">
<nav class="mechanic-breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li aria-current="page">Contrôle technique</li></ol></nav><h1>Contrôle technique</h1><p>Nous vous accompagnons dans la préparation et la<br>réalisation du contrôle technique pour rouler en toute<br>sérénité.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div></div></header>
<main class="mechanic-page inspection-page"><div class="container">
<section class="inspection-benefits" aria-label="Avantages du contrôle technique">{% for item in [{icon:'shield',title:'Véhicule sécurisé',text:'Vérification des points de sécurité essentiels'},{icon:'document',title:'Conformité réglementaire',text:'Selon la législation en vigueur'},{icon:'vehicle',title:'Accompagnement complet',text:'Conseils et prise de rendez-vous'},{icon:'clock',title:'Gain de temps',text:'Pré-contrôle pour éviter une contre-visite'},{icon:'badge',title:'Tarifs transparents',text:'Devis clair et sans surprise'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</section>
<div class="row g-4"><div class="col-lg-8"><section class="inspection-services" aria-labelledby="services-ct"><h2 id="services-ct">Nos services liés au contrôle technique</h2><div>{% for card in [{title:'Pré-contrôle technique',text:'Vérification des points clés pour maximiser vos chances de validation.',price:'À partir de 39 €'},{title:'Correction des défauts',text:'Prise en charge des réparations nécessaires avant la contre-visite.',price:'Sur devis'},{title:'Prise de rendez-vous',text:'Nous planifions votre contrôle technique dans un centre agréé proche de Poissy.',price:'Service offert'}] %}<article class="mechanic-card"><div class="inspection-card__photo inspection-card__photo--{{ loop.index }}" role="img" aria-label="{{ card.title }}"></div><h3>{{ card.title }}</h3><p>{{ card.text }}</p><div><strong>{{ card.price }}</strong><a href="{{ path('rendez_vous') }}" aria-label="Demander {{ card.title }}">{{ icons.svg('chevron-right') }}</a></div></article>{% endfor %}</div></section>
<section class="climate-benefits inspection-trust" aria-labelledby="confiance-ct"><h2 id="confiance-ct">Pourquoi nous faire confiance&nbsp;?</h2><div>{% for item in [{icon:'shield',title:'Techniciens qualifiés',text:'Plus de 10 ans d’expérience'},{icon:'home-distribution',title:'Diagnostic précis',text:'Matériel de pointe'},{icon:'people',title:'Accompagnement',text:'Conseils personnalisés'},{icon:'vehicle',title:'Sérénité',text:'Un véhicule en règle et plus sûr'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</div></section>
<section class="mechanic-faq" aria-labelledby="faq-ct"><h2 id="faq-ct">Questions fréquentes</h2>{% for item in [{q:'À quelle fréquence faut-il passer le contrôle technique ?',a:'Le premier contrôle intervient généralement avant le quatrième anniversaire, puis tous les deux ans.'},{q:'Que se passe-t-il en cas de contre-visite ?',a:'Les défauts concernés doivent être corrigés dans le délai indiqué.'},{q:'Proposez-vous un pré-contrôle ?',a:'Oui, nous vérifions les principaux points afin de limiter le risque de contre-visite.'},{q:'Combien de temps dure un contrôle technique ?',a:'Comptez généralement moins d’une heure.'},{q:'Puis-je prendre rendez-vous directement avec vous ?',a:'Oui, nous vous accompagnons auprès d’un centre agréé.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section></div>
<aside class="col-lg-4"><div class="mechanic-contact"><h2>{{ icons.svg('clock') }} Horaires d’ouverture</h2>{% for groupe in horaires_groupes() %}<div class="mechanic-contact__hours"><span>{{ groupe.jours }}</span><strong>{{ groupe.horaires }}</strong></div>{% endfor %}<a class="btn btn-primary w-100" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-primary w-100" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}{% if site.adresse %}<p class="mechanic-contact__address">{{ icons.svg('pin') }} <span>{{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Voir l’itinéraire</a>{% endif %}</span></p>{% endif %}</div><div class="inspection-docs"><h2>{{ icons.svg('document') }} Documents à prévoir</h2><ul><li>{{ icons.svg('check') }} Carte grise du véhicule</li><li>{{ icons.svg('check') }} Dernier procès-verbal (si contre-visite)</li><li>{{ icons.svg('check') }} Pièce d’identité</li></ul></div></aside></div>
</div></main>
