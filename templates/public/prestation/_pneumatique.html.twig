{% import 'components/_icons.html.twig' as icons %}
{% set site = parametres_site() %}
<header class="mechanic-hero tire-hero"><img src="{{ asset('images/img-pneumatique/hero-pneumatique.png') }}" alt="" width="2172" height="724" loading="eager" fetchpriority="high"><div class="mechanic-hero__shade" aria-hidden="true"></div><div class="container mechanic-hero__content">
    <nav class="mechanic-breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li aria-current="page">Pneumatiques</li></ol></nav>
    <h1>Pneumatiques</h1><p>Conseil, vente, montage et équilibrage<br>de vos pneus pour plus de sécurité<br>en toutes conditions.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div>
</div></header>
<main class="mechanic-page tire-page"><div class="container">
    <section class="tire-benefits" aria-label="Nos engagements pneumatiques">{% for item in [
        {icon:'home-tire', title:'Grand choix de marques', text:'Premium, milieu de gamme et entrée de gamme'}, {icon:'home-distribution', title:'Montage rapide', text:'Par nos techniciens qualifiés'}, {icon:'home-brake', title:'Équilibrage inclus', text:'Pour un meilleur confort de conduite'}, {icon:'people', title:'Conseils personnalisés', text:'Selon votre véhicule et votre usage'}, {icon:'badge', title:'Tarifs compétitifs', text:'Devis clair et transparent'}, {icon:'calendar', title:'Prise de rendez-vous en ligne', text:'Simple et rapide'}
    ] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</section>

    <section class="tire-services" aria-labelledby="services-pneus"><div class="tire-section-title"><h2 id="services-pneus">Nos prestations pneumatiques</h2><a href="{{ path('prestations_index') }}">Voir toutes les prestations →</a></div><div class="mechanic-services">{% for card in [
        {title:'Vente de pneus', text:'Tourisme, SUV, utilitaire', price:'À partir de 59 €'}, {title:'Montage', text:'Montage sur jante', price:'À partir de 15 € / pneu'}, {title:'Équilibrage', text:'Pour plus de stabilité', price:'À partir de 15 € / pneu'}, {title:'Géométrie / Parallélisme', text:'Usure maîtrisée', price:'À partir de 59 €'}, {title:'Réparation crevaison', text:'Selon la nature de la crevaison', price:'À partir de 25 €'}, {title:'Permutation saisonnière', text:'Été / Hiver', price:'À partir de 20 €'}
    ] %}<article class="mechanic-card"><div class="mechanic-card__photo tire-card__photo tire-card__photo--{{ loop.index }}" role="img" aria-label="{{ card.title }}"></div><h3>{{ card.title }}</h3><p>{{ card.text }}</p><div><strong>{{ card.price }}</strong><a href="{{ path('rendez_vous') }}" aria-label="Demander un rendez-vous pour {{ card.title }}">{{ icons.svg('chevron-right') }}</a></div></article>{% endfor %}</div></section>

    <section class="tire-brands" aria-labelledby="marques-pneus"><h2 id="marques-pneus">Nos marques partenaires</h2><div>{% for marque in ['MICHELIN','Continental','BRIDGESTONE','GOODYEAR','PIRELLI','DUNLOP','HANKOOK','Kleber'] %}<span>{{ marque }}</span>{% endfor %}</div></section>

    <div class="row g-4 tire-lower"><div class="col-lg-8">
        <section class="tire-advice" aria-labelledby="bon-a-savoir"><h2 id="bon-a-savoir">{{ icons.svg('document') }} Bon à savoir</h2><div>{% for item in [{icon:'home-distribution', title:'Usure des pneus', text:'Vérifiez régulièrement la profondeur des rainures (minimum légal : 1,6 mm)'}, {icon:'shield', title:'Sécurité', text:'Des pneus en bon état améliorent le freinage et la tenue de route'}, {icon:'badge', title:'Économie', text:'Un bon entretien prolonge la durée de vie de vos pneus et réduit votre consommation'}] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section>
        <section class="mechanic-faq" aria-labelledby="faq-pneus"><h2 id="faq-pneus">Questions fréquentes</h2>{% for item in [{q:'Quelle est la durée de vie d’un pneu ?',a:'Elle dépend du kilométrage, de la conduite, du stockage et de l’entretien.'},{q:'Quand faut-il changer ses pneus ?',a:'Lorsque les témoins d’usure sont atteints, en cas de dommage ou selon leur ancienneté.'},{q:'Proposez-vous des pneus toutes marques ?',a:'Oui, nous proposons plusieurs marques et gammes selon votre budget.'},{q:'Le parallélisme est-il nécessaire ?',a:'Il est conseillé en cas d’usure irrégulière ou lorsque le véhicule tire d’un côté.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section>
    </div><aside class="col-lg-4"><div class="mechanic-contact"><h2>{{ icons.svg('clock') }} Horaires d’ouverture</h2>{% for groupe in horaires_groupes() %}<div class="mechanic-contact__hours"><span>{{ groupe.jours }}</span><strong>{{ groupe.horaires }}</strong></div>{% endfor %}<a class="btn btn-primary w-100" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-primary w-100" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}{% if site.adresse %}<p class="mechanic-contact__address">{{ icons.svg('pin') }} <span>{{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Voir l’itinéraire</a>{% endif %}</span></p>{% endif %}</div></aside></div>
</div></main>
