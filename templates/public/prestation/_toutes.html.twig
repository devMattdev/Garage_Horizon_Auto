{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
<header class="services-landing-hero"><img src="{{ asset('images/img-accueil/hero-atelier-1600.jpg') }}" alt="" width="1600" height="683" loading="eager" fetchpriority="high"><div aria-hidden="true"></div><div class="container"><h1>Nos prestations</h1><p>Un entretien complet pour plus de sécurité, de performance<br>et pour prolonger la durée de vie de votre véhicule.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div></div></header>
<main class="services-landing"><div class="container">
<section aria-labelledby="categories-services"><div class="services-landing__heading"><h2 id="categories-services">Nos services par catégorie</h2><label class="service-search">{{ icons.svg('search') }}<span class="visually-hidden">Rechercher une prestation</span><input type="search" placeholder="Rechercher une prestation…"></label></div><div class="category-grid">{% for item in [
{icon: 'wrench', title: 'Mécanique', text: 'Entretien, réparation et remplacement de pièces mécaniques.', family: 'mecanique'}, {icon: 'home-tire', title: 'Pneumatiques', text: 'Vente, montage, équilibrage et réparation de pneus.', family: 'pneumatique'}, {icon: 'home-snow', title: 'Climatisation', text: 'Entretien, recharge et dépannage de votre système de climatisation.', family: 'climatisation'}, {icon: 'home-engine', title: 'Diagnostic', text: 'Diagnostic électronique et recherche de pannes.', family: 'diagnostic'}, {icon: 'document', title: 'Contrôle technique', text: 'Préparation et accompagnement pour un contrôle technique serein.', family: 'controle_technique'}, {icon: 'battery', title: 'Électricité / Batterie', text: 'Diagnostic et remplacement de batterie, alternateur, démarreur, etc.', family: 'diagnostic'}, {icon: 'home-oil', title: 'Entretien courant', text: 'Vidange, filtres, niveaux et contrôles essentiels.', family: 'entretien'}, {icon: 'vehicle', title: 'Autres services', text: 'Échappement, suspension, distribution et bien plus encore.', family: 'mecanique'}
] %}<a class="category-card" href="{{ path('prestations_index', {famille: item.family}) }}"><span>{{ icons.svg(item.icon) }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p><b>{{ icons.svg('chevron-right') }}</b></a>{% endfor %}</div></section>
</div>
<section class="landing-trust"><div class="container">{% for item in [{icon: 'shield', title: 'Pièces de qualité', text: 'Marques d’origine ou équivalentes'}, {icon: 'home-distribution', title: 'Techniciens qualifiés', text: 'Plus de 10 ans d’expérience'}, {icon: 'clock', title: 'Devis transparent', text: 'Sans surprise'}, {icon: 'thumb', title: 'Garantie sur nos interventions', text: 'Roulez en toute confiance'}] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section>
<div class="container">
<section class="landing-process" aria-labelledby="processus"><h2 id="processus">Notre processus d’intervention</h2><div>{% for item in [{icon: 'document', title: 'Prise de contact', text: 'En ligne, par téléphone ou sur place'}, {icon: 'people', title: 'Diagnostic / Devis', text: 'Analyse et proposition claire et détaillée'}, {icon: 'wrench', title: 'Intervention', text: 'Réalisation par nos techniciens qualifiés'}, {icon: 'check', title: 'Véhicule prêt', text: 'Contrôle final et restitution en toute sérénité'}] %}<article><b>{{ loop.index }}</b><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section>
<div class="row g-4 landing-lower"><section class="col-lg-6 mechanic-faq" aria-labelledby="faq-services"><h2 id="faq-services">Questions fréquentes</h2>{% for item in [{q: 'Faut-il prendre rendez-vous ?', a: 'Le rendez-vous est recommandé afin de réduire votre attente.'}, {q: 'Proposez-vous un véhicule de courtoisie ?', a: 'Oui, selon les disponibilités au moment de votre intervention.'}, {q: 'Utilisez-vous des pièces d’origine ?', a: 'Nous utilisons des pièces d’origine ou de qualité équivalente.'}, {q: 'Combien de temps dure une intervention ?', a: 'La durée dépend de l’opération et vous est communiquée avec le devis.'}, {q: 'Les devis sont-ils payants ?', a: 'Contactez le garage pour connaître les conditions selon le diagnostic demandé.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section><aside class="col-lg-6 landing-contact"><img src="{{ asset('images/img-mecanique/pieces-mecaniques.png') }}" alt="Roue d’un véhicule dans l’atelier" width="2172" height="724" loading="lazy"><div><h2>Un besoin spécifique&nbsp;?</h2><p>Notre équipe est à votre écoute pour répondre à toutes vos questions et vous conseiller.</p><a class="btn btn-primary" href="{{ path('contact') }}">Nous contacter {{ icons.svg('chevron-right') }}</a></div></aside></div>
</div></main>
<section class="landing-cta"><div class="container"><span>{{ icons.svg('calendar') }}</span><div><h2>Prenez rendez-vous dès maintenant</h2><p>Un entretien rapide, un véhicule plus sûr.</p></div><a class="btn btn-outline-light btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a></div></section>
