{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
<header class="mechanic-hero"><img src="{{ asset('images/img-diagnostic/hero-diagnostic.png') }}" alt="" width="2172" height="724" loading="eager" fetchpriority="high"><div class="mechanic-hero__shade" aria-hidden="true"></div><div class="container mechanic-hero__content">
<nav class="mechanic-breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li aria-current="page">Diagnostic</li></ol></nav><h1>Diagnostic</h1><p>Identifiez rapidement et fiablement les pannes<br>et problèmes électroniques de votre véhicule.<br><small>Un diagnostic complet réalisé avec des outils de pointe<br>pour une intervention ciblée et efficace.</small></p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div>
</div></header>
<main class="mechanic-page diagnostic-page"><div class="container">
<section class="tire-benefits" aria-label="Nos engagements diagnostic">{% for item in [{icon:'scan',title:'Diagnostic électronique',text:'Analyse complète des systèmes embarqués'},{icon:'search',title:'Recherche de panne',text:'Identification rapide et précise'},{icon:'home-engine',title:'Lecture des voyants',text:'Interprétation des codes défaut'},{icon:'vehicle',title:'Intervention toutes marques',text:'Véhicules essence, diesel, hybride et électrique'},{icon:'badge',title:'Devis transparent',text:'Tarifs clairs avant intervention'},{icon:'clock',title:'Rendez-vous rapide',text:'Créneaux disponibles en ligne'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</section>
<section class="tire-services" aria-labelledby="services-diag"><div class="tire-section-title"><h2 id="services-diag">Nos prestations diagnostic</h2></div><div class="mechanic-services">{% for card in [{title:'Diagnostic électronique',text:'Lecture et analyse complète des calculateurs',price:'À partir de 49 €'},{title:'Lecture voyant moteur',text:'Identification et explication des codes défaut',price:'À partir de 29 €'},{title:'Recherche de panne',text:'Diagnostic approfondi des pannes complexes',price:'À partir de 69 €'},{title:'Diagnostic batterie / alternateur',text:'Contrôle du circuit de charge et de démarrage',price:'À partir de 19 €'},{title:'Pré-contrôle technique',text:'Vérification des points clés avant le contrôle technique',price:'À partir de 29 €'},{title:'Effacement défaut',text:'Suppression des codes défaut après réparation',price:'À partir de 25 €'}] %}<article class="mechanic-card"><div class="mechanic-card__photo diagnostic-card__photo diagnostic-card__photo--{{ loop.index }}" role="img" aria-label="{{ card.title }}"></div><h3>{{ card.title }}</h3><p>{{ card.text }}</p><div><strong>{{ card.price }}</strong><a href="{{ path('rendez_vous') }}" aria-label="Demander un rendez-vous pour {{ card.title }}">{{ icons.svg('chevron-right') }}</a></div></article>{% endfor %}</div></section>
<div class="row g-4 tire-lower"><div class="col-lg-8">
<section class="climate-benefits" aria-labelledby="pourquoi-diag"><h2 id="pourquoi-diag">Pourquoi choisir Horizon Auto pour votre diagnostic&nbsp;?</h2><div>{% for item in [{icon:'home-distribution',title:'Techniciens qualifiés',text:'Une équipe formée aux dernières technologies'},{icon:'wrench',title:'Outils de diagnostic professionnels',text:'Matériel multimarque de dernière génération'},{icon:'document',title:'Devis avant intervention',text:'Une transparence totale sur nos tarifs'},{icon:'vehicle',title:'Véhicule de courtoisie',text:'Selon disponibilité pendant l’intervention'}] %}<article><span>{{ icons.svg(item.icon) }}</span><strong>{{ item.title }}</strong><p>{{ item.text }}</p></article>{% endfor %}</div></section>
<section class="mechanic-faq" aria-labelledby="faq-diag"><h2 id="faq-diag">Questions fréquentes</h2>{% for item in [{q:'Pourquoi mon voyant moteur s’allume-t-il ?',a:'Il signale une anomalie détectée par le véhicule. Un diagnostic permet d’en identifier précisément la cause.'},{q:'Combien coûte un diagnostic ?',a:'Le tarif dépend du niveau de recherche nécessaire et vous est annoncé avant intervention.'},{q:'Travaillez-vous sur toutes les marques ?',a:'Oui, notre matériel est compatible avec de nombreuses marques et motorisations.'},{q:'Le diagnostic efface-t-il la panne ?',a:'Non, il identifie son origine. La réparation nécessaire fait ensuite l’objet d’un devis.'},{q:'Faut-il prendre rendez-vous ?',a:'La prise de rendez-vous est recommandée afin de réserver le temps nécessaire.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section>
</div><aside class="col-lg-4"><div class="mechanic-contact"><h2>{{ icons.svg('clock') }} Horaires d’ouverture</h2>{% for groupe in horaires_groupes() %}<div class="mechanic-contact__hours"><span>{{ groupe.jours }}</span><strong>{{ groupe.horaires }}</strong></div>{% endfor %}<a class="btn btn-primary w-100" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-primary w-100" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}{% if site.adresse %}<p class="mechanic-contact__address">{{ icons.svg('pin') }} <span>{{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Voir l’itinéraire</a>{% endif %}</span></p>{% endif %}<div class="climate-help">{{ icons.svg('scan') }}<p><strong>Un doute sur un voyant ou un message&nbsp;?</strong><br>Nos experts vous conseillent gratuitement.</p></div></div></aside></div>
</div></main>
