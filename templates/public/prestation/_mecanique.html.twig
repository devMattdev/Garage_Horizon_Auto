{% import 'components/_icons.html.twig' as icons %}
{% set site = parametres_site() %}
<header class="mechanic-hero">
    <img src="{{ asset('images/img-mecanique/hero-mecanique.png') }}" alt="" width="2172" height="724" loading="eager" fetchpriority="high">
    <div class="mechanic-hero__shade" aria-hidden="true"></div>
    <div class="container mechanic-hero__content">
        <nav class="mechanic-breadcrumb" aria-label="Fil d’Ariane"><ol><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li aria-current="page">Mécanique</li></ol></nav>
        <h1>Mécanique</h1>
        <p>Des interventions mécaniques fiables et durables<br>pour garantir votre sécurité et la performance<br>de votre véhicule.</p>
        <div class="d-flex flex-wrap gap-3"><a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}</div>
    </div>
</header>

<main class="mechanic-page"><div class="container">
    <section class="mechanic-services" aria-label="Prestations mécaniques">
        {% for card in [
            {title: 'Freinage', text: 'Plaquettes, disques, liquide de frein', price: 'À partir de 99 €'},
            {title: 'Distribution', text: 'Courroie ou chaîne de distribution', price: 'À partir de 249 €'},
            {title: 'Embrayage', text: 'Remplacement complet', price: 'À partir de 399 €'},
            {title: 'Suspension', text: 'Amortisseurs, ressorts, triangles, rotules', price: 'À partir de 149 €'},
            {title: 'Échappement', text: 'Silencieux, catalyseur, ligne d’échappement', price: 'À partir de 149 €'},
            {title: 'Moteur', text: 'Diagnostic et réparation moteur', price: 'Sur devis'}
        ] %}<article class="mechanic-card"><div class="mechanic-card__photo mechanic-card__photo--{{ loop.index }}" role="img" aria-label="{{ card.title }}"></div><h2>{{ card.title }}</h2><p>{{ card.text }}</p><div><strong>{{ card.price }}</strong><a href="{{ path('rendez_vous') }}" aria-label="Demander un rendez-vous pour {{ card.title }}">{{ icons.svg('chevron-right') }}</a></div></article>{% endfor %}
    </section>

    <div class="row g-4 mechanic-content">
        <div class="col-lg-8">
            <section class="mechanic-support" aria-labelledby="accompagnement"><h2 id="accompagnement">Un accompagnement complet</h2><div>{% for item in [
                {icon: 'document', title: 'Devis avant intervention', text: 'Transparent et sans surprise'}, {icon: 'home-distribution', title: 'Pièces de qualité', text: 'Marques d’origine ou équivalentes'}, {icon: 'shield', title: 'Garantie', text: 'Sur toutes nos interventions'}, {icon: 'home-engine', title: 'Véhicule de courtoisie', text: 'Selon disponibilité'}
            ] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section>

            <section class="mechanic-faq" aria-labelledby="faq-mecanique"><h2 id="faq-mecanique">Questions fréquentes</h2>{% for item in [
                {q: 'Quels sont les signes d’un problème mécanique ?', a: 'Bruits inhabituels, vibrations, voyant allumé ou perte de puissance doivent vous amener à faire contrôler le véhicule.'}, {q: 'Combien de temps dure une intervention ?', a: 'La durée dépend du diagnostic et des pièces nécessaires. Elle vous est précisée avant les travaux.'}, {q: 'Les pièces sont-elles garanties ?', a: 'Oui, les pièces et interventions bénéficient des garanties applicables.'}, {q: 'Puis-je obtenir un devis avant les travaux ?', a: 'Oui, un devis détaillé vous est présenté avant toute intervention.'}
            ] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section>
        </div>

        <aside class="col-lg-4"><div class="mechanic-contact"><h2>{{ icons.svg('clock') }} Horaires d’ouverture</h2>{% for groupe in horaires_groupes() %}<div class="mechanic-contact__hours"><span>{{ groupe.jours }}</span><strong>{{ groupe.horaires }}</strong></div>{% endfor %}<a class="btn btn-primary w-100" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Prendre rendez-vous</a>{% if site.telephone %}<a class="btn btn-outline-primary w-100" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}{% if site.adresse %}<p class="mechanic-contact__address">{{ icons.svg('pin') }} <span>{{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Voir l’itinéraire</a>{% endif %}</span></p>{% endif %}</div></aside>
    </div>
</div></main>
