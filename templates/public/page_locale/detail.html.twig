{% extends 'base.html.twig' %}
{% block title %}{{ page.seoTitre ?: page.titre }} — {{ parent() }}{% endblock %}
{% block meta_description %}{{ page.seoDescription }}{% endblock %}
{% block body %}
    {% include 'components/_breadcrumb.html.twig' with {items: [{label: 'Accueil', url: path('accueil')}, {label: page.titre}]} %}
    <header class="page-hero"><div class="container"><p class="section-eyebrow">Secteur desservi</p><h1>{{ page.titre }}</h1></div></header>
    <article class="container section-space prose">{{ page.contenu|nl2br }}<div class="mt-5"><a class="btn btn-primary" href="{{ path('rendez_vous') }}">Contacter le garage</a></div></article>
{% endblock %}
