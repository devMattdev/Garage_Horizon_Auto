{% extends 'base.html.twig' %}{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
{% block title %}Professionnels — {{ parent() }}{% endblock %}{% block meta_description %}Entretien et réparation des véhicules d’entreprise, suivi de flotte et facturation adaptée.{% endblock %}
{% block body %}
<header class="pro-hero"><img src="{{ asset('images/img-professionnels/hero-vehicules-entreprise.png') }}" alt="" width="1942" height="809" loading="eager"><div class="container"><p class="section-eyebrow">Professionnels</p><h1>Un garage partenaire pour<br>vos véhicules d’entreprise</h1><p>Artisans, commerces, flottes d’entreprise : confiez l’entretien de vos véhicules à un interlocuteur unique, avec une facturation adaptée à votre structure.</p><div class="d-flex flex-wrap gap-3"><a class="btn btn-primary" href="{{ path('rendez_vous', {type: 'devis'}) }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a><a class="btn btn-outline-primary" href="{{ path('contact') }}">Nous contacter</a></div><div class="pro-proof"><span>{{ icons.svg('people') }} <b>Des entreprises</b><small>nous font confiance</small></span><span>{{ icons.svg('home-distribution') }} <b>Un service dédié</b><small>aux professionnels</small></span><span>{{ icons.svg('pin') }} <b>À {{ site.ville }}</b><small>et sa région</small></span></div></div></header>
<main class="pro-page"><div class="container"><section class="pro-services" aria-labelledby="pro-services"><p class="section-eyebrow">Nos services pour les professionnels</p><h2 id="pro-services">Un service complet pour toutes vos activités</h2><div>{% for item in [{icon: 'wrench', title: 'Entretien', text: 'Entretien courant selon les préconisations constructeur.'}, {icon: 'document', title: 'Révision', text: 'Révisions toutes marques pour une sécurité optimale.'}, {icon: 'home-tire', title: 'Pneumatiques', text: 'Montage, équilibrage et remplacement de vos pneumatiques.'}, {icon: 'vehicle', title: 'Véhicules utilitaires', text: 'Maintenance adaptée à vos utilitaires et véhicules professionnels.'}, {icon: 'scan', title: 'Diagnostic', text: 'Recherche de panne et diagnostic électronique toutes marques.'}, {icon: 'people', title: 'Suivi de flotte', text: 'Un accompagnement personnalisé pour vos parcs de véhicules.'}] %}<article><span>{{ icons.svg(item.icon) }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p></article>{% endfor %}</div></section></div>
<section class="pro-benefits"><div class="container"><p class="section-eyebrow">Vos avantages chez Horizon Auto</p><h2>Un partenariat simple et efficace</h2><div>{% for item in [{icon: 'document', title: 'Facturation adaptée', text: 'Une facturation claire et adaptée à votre structure.'}, {icon: 'vehicle', title: 'Véhicule de courtoisie', text: 'Selon disponibilité pour limiter l’impact sur votre activité.'}, {icon: 'people', title: 'Un interlocuteur unique', text: 'Un conseiller dédié pour un suivi personnalisé.'}, {icon: 'check', title: 'Devis avant intervention', text: 'Un devis systématique pour une totale transparence.'}] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></div></section>
<div class="container"><section class="pro-process"><p class="section-eyebrow">Notre processus</p><h2>Un fonctionnement pensé pour les entreprises</h2><div>{% for item in [{title: 'Premier échange', text: 'Nous identifions vos besoins et votre parc de véhicules.'}, {title: 'Proposition personnalisée', text: 'Une offre adaptée à votre activité.'}, {title: 'Interventions simplifiées', text: 'Vous nous confiez vos véhicules, nous nous occupons du reste.'}, {title: 'Suivi et reporting', text: 'Un suivi régulier pour optimiser l’entretien de votre flotte.'}] %}<article><b>{{ loop.index }}</b><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section>
<section class="pro-banner"><div><small>Un garage de confiance</small><h2>Concentrez-vous sur votre activité,<br>nous prenons soin de vos véhicules.</h2></div><div><a class="btn btn-primary" href="{{ path('rendez_vous', {type: 'devis'}) }}">Demander un rendez-vous →</a><small>Réponse sous 24h en jour ouvré</small></div></section>
<div class="row g-4 pro-lower"><section class="col-lg-6 mechanic-faq"><p class="section-eyebrow">Questions fréquentes</p><h2>Vos questions, nos réponses</h2>{% for item in [{q: 'Travaillez-vous avec des flottes de toutes tailles ?', a: 'Oui, nous adaptons notre accompagnement au nombre de véhicules et à votre activité.'}, {q: 'Proposez-vous des facilités de paiement ?', a: 'Contactez-nous pour étudier les modalités adaptées à votre entreprise.'}, {q: 'Puis-je bénéficier d’un véhicule de courtoisie ?', a: 'Oui, selon les disponibilités lors de votre intervention.'}, {q: 'Faites-vous les interventions sur site ?', a: 'Les interventions sont réalisées dans notre atelier équipé.'}] %}<details><summary>{{ item.q }}</summary><p>{{ item.a }}</p></details>{% endfor %}</section><aside class="col-lg-6 pro-contact"><div><p class="section-eyebrow">Nous contacter</p><h2>Une question ?<br>Notre équipe vous répond</h2>{% if site.telephone %}<p>{{ icons.svg('phone') }} <a href="tel:{{ telephone_uri(site.telephone) }}">{{ site.telephone }}</a></p>{% endif %}{% if site.email %}<p>{{ icons.svg('mail') }} <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>{% endif %}<p>{{ icons.svg('pin') }} {{ site.adresse }}, {{ site.codePostal }} {{ site.ville }}</p></div><img src="{{ asset('images/img-accueil/devanture-garage-700.jpg') }}" alt="Devanture du garage" width="700" height="394" loading="lazy"></aside></div></div></main>
{% endblock %}
