{% extends 'base.html.twig' %}

{% block title %}Contact — {{ parent() }}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if turnstile_site_key %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {% endif %}
{% endblock %}

{% block body %}
    <div class="container py-5 container-etroit">
        <h1 class="h2 mb-4">Nous contacter</h1>
        <p class="text-muted">
            {{ parametres_site().raisonSociale }} — {{ parametres_site().telephone }}<br>
            Réponse sous {{ parametres_site().delaiReponseJoursOuvres }} jours ouvrés.
        </p>

        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.type) }}
            {{ form_row(form.nom) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                <div class="col-md-6">{{ form_row(form.email) }}</div>
            </div>
            {{ form_row(form.immatriculation) }}
            {{ form_row(form.kilometrage) }}
            {{ form_row(form.prestation) }}
            {{ form_row(form.vehicule) }}
            {{ form_row(form.creneauSouhaite) }}
            {{ form_row(form.message) }}
            {{ form_row(form.consentementRelance) }}

            <div class="visually-hidden">
                {{ form_label(form.siteWeb, 'Ne pas remplir ce champ', {label_attr: {for: 'demande_siteWeb'}}) }}
                {{ form_widget(form.siteWeb, {attr: {tabindex: '-1', autocomplete: 'off'}}) }}
            </div>

            {% if turnstile_site_key %}
                <div class="cf-turnstile mb-3" data-sitekey="{{ turnstile_site_key }}" data-callback="onTurnstileSuccess"></div>
            {% endif %}
            {{ form_widget(form.cfTurnstileResponse, {attr: {id: 'demande_cfTurnstileResponseHidden', type: 'hidden'}}) }}

            <button type="submit" class="btn btn-primary">Envoyer ma demande</button>
        {{ form_end(form) }}
    </div>

    {% if turnstile_site_key %}
        <script nonce="{{ csp_nonce('script') }}">
            function onTurnstileSuccess(token) {
                document.getElementById('demande_cfTurnstileResponseHidden').value = token;
            }
        </script>
    {% endif %}
{% endblock %}
