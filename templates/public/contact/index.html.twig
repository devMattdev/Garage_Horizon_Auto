{% extends 'base.html.twig' %}{% import 'components/_icons.html.twig' as icons %}{% set site = parametres_site() %}
{% block title %}Contact et accès — {{ parent() }}{% endblock %}{% block meta_description %}Contactez le garage {{ site.raisonSociale ?: 'Horizon Auto' }} et préparez votre venue à {{ site.ville }}.{% endblock %}
{% block body %}
<header class="contact-hero"><div class="container"><nav><a href="{{ path('accueil') }}">Accueil</a><span>›</span><b>Contact</b></nav><div><p class="section-eyebrow">Informations pratiques</p><h1>Contact et accès</h1><p>Appelez directement le garage ou transmettez une demande en ligne.</p></div></div><img src="{{ asset('images/img-accueil/devanture-garage-1000.jpg') }}" alt="Devanture du garage" width="1000" height="563" loading="eager"></header>
<main class="contact-page"><div class="container"><div class="row g-4"><section class="col-lg-7 contact-form" aria-labelledby="envoyer-message"><h2 id="envoyer-message">Nous envoyer un message</h2><p>Remplissez le formulaire ci-dessous, notre équipe vous répond dans les plus brefs délais.</p>
{{ form_start(form, {attr: {'data-controller': 'formulaire-demande'}}) }}{% if form.vars.submitted and not form.vars.valid %}<div class="alert alert-danger" role="alert">Merci de corriger les champs signalés.</div>{% endif %}<div class="contact-form__type">{{ form_row(form.type) }}</div>{{ form_row(form.nom) }}<div class="contact-form__two">{{ form_row(form.telephone) }}{{ form_row(form.email) }}</div><div data-formulaire-demande-target="prestation">{{ form_row(form.prestation) }}</div><div data-formulaire-demande-target="vehicule">{{ form_row(form.vehicule) }}</div>{{ form_row(form.immatriculation) }}{{ form_row(form.kilometrage) }}{{ form_row(form.creneauSouhaite) }}{{ form_row(form.message) }}{{ form_row(form.consentementRelance) }}<p class="small">Vos données sont utilisées uniquement pour traiter votre demande. <a href="{{ path('politique_confidentialite') }}">Politique de confidentialité</a>.</p><div class="hp-field">{{ form_widget(form.siteWeb) }}</div>{{ form_widget(form.cfTurnstileResponse, {attr: {type: 'hidden'}}) }}<button class="btn btn-primary btn-lg" type="submit">{{ icons.svg('mail') }} Envoyer ma demande</button>{{ form_end(form) }}</section>
<aside class="col-lg-5"><section class="contact-details"><h2>Nos coordonnées</h2>{% if site.telephone %}<div>{{ icons.svg('phone') }}<p><strong><a href="tel:{{ telephone_uri(site.telephone) }}">{{ site.telephone }}</a></strong><small>Lun - Ven : 8h - 12h / 13h30 - 18h</small></p></div>{% endif %}{% if site.email %}<div>{{ icons.svg('mail') }}<p><strong><a href="mailto:{{ site.email }}">{{ site.email }}</a></strong><small>Réponse sous 24h</small></p></div>{% endif %}<div>{{ icons.svg('pin') }}<p><strong>{{ site.adresse }}</strong><small>{{ site.codePostal }} {{ site.ville }}</small></p>{% if site.urlFicheGoogle %}<a href="{{ site.urlFicheGoogle }}">Itinéraire →</a>{% endif %}</div></section><section class="contact-map"><h2>Nous trouver</h2>{% include 'components/_map.html.twig' %}{% if site.urlFicheGoogle %}<a class="btn btn-outline-primary w-100" href="{{ site.urlFicheGoogle }}">{{ icons.svg('pin') }} Ouvrir dans Google Maps</a>{% endif %}</section></aside></div></div>
<section class="contact-practical"><div class="container">{% for item in [{icon: 'clock', title: 'Horaires d’ouverture', text: 'Lun - Ven : 8h - 12h / 13h30 - 18h'}, {icon: 'vehicle', title: 'Accès', text: 'Parking clients sur place'}, {icon: 'swap', title: 'Transports en commun', text: 'Gare de Poissy à proximité'}, {icon: 'people', title: 'Accessibilité', text: 'Site accessible aux personnes à mobilité réduite'}] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</div></section></main>
{% endblock %}
