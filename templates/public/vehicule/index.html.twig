{% extends 'base.html.twig' %}

{% block title %}Véhicules d'occasion — {{ parent() }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <h1 class="h2 mb-4">Véhicules d'occasion</h1>
        <div class="row g-4">
            {% for vehicule in vehicules %}
                <div class="col-md-4">
                    <div class="card h-100">
                        {% set photos = vehicule.photosTriees %}
                        {% if photos|length > 0 %}
                            <picture>
                                <source srcset="{{ path('photo_vehicule', {id: photos[0].id, variante: 'carte', format: 'webp'}) }}" type="image/webp">
                                <img src="{{ path('photo_vehicule', {id: photos[0].id, variante: 'carte', format: 'jpg'}) }}" alt="{{ photos[0].texteAlternatif }}" class="card-img-top" width="800" loading="lazy">
                            </picture>
                        {% endif %}
                        <div class="card-body">
                            <h2 class="h5 card-title">{{ vehicule.titre }}</h2>
                            <p class="card-text mb-1">{{ vehicule.misEnCirculationLe|date('Y') }} — {{ vehicule.kilometrage|number_format(0, ',', ' ') }} km</p>
                            <p class="card-text mb-1">{{ vehicule.energie.value|capitalize }} — {{ vehicule.boite.value|capitalize }}</p>
                            {% if vehicule.prix %}<p class="fw-bold">{{ vehicule.prix|number_format(0, ',', ' ') }} €</p>{% endif %}
                            <a class="stretched-link" href="{{ path('vehicule_detail', {reference: vehicule.reference}) }}">Voir la fiche</a>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Aucun véhicule disponible pour le moment.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
