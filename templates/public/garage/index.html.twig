{% extends 'base.html.twig' %}{% import 'components/_icons.html.twig' as icons %}{% set site=parametres_site() %}
{% block title %}Le garage — {{ parent() }}{% endblock %}{% block meta_description %}Découvrez le garage {{ site.raisonSociale ?: 'Horizon Auto' }}, son histoire, ses valeurs et ses engagements à {{ site.ville }}.{% endblock %}
{% block body %}
<main class="garage-page"><div class="container"><nav class="garage-breadcrumb" aria-label="Fil d’Ariane"><a href="{{ path('accueil') }}">Accueil</a><span>›</span><b>À propos</b></nav>
<section class="garage-intro"><div><p class="section-eyebrow">À propos</p><h1>Le garage {{ site.raisonSociale ?: 'Horizon Auto' }}</h1><p class="garage-lead">Un interlocuteur local pour l’entretien, la réparation et votre recherche de véhicule d’occasion.</p><div class="garage-facts"><article>{{ icons.svg('people') }}<div><strong>Plus de 10 ans</strong><span>d’expérience</span></div></article><article>{{ icons.svg('pin') }}<div><strong>À {{ site.ville }}</strong><span>au service des particuliers et des professionnels</span></div></article><article>{{ icons.svg('wrench') }}<div><strong>Un service</strong><span>de proximité et de confiance</span></div></article></div></div><img src="{{ asset('images/img-accueil/devanture-garage-1000.jpg') }}" alt="Devanture du garage {{ site.raisonSociale ?: 'Horizon Auto' }}" width="1000" height="563" loading="eager"></section>
<section class="garage-pillars" aria-label="Nos engagements">{% for item in [{icon:'home-distribution',title:'Un savoir-faire reconnu',text:'Des techniciens qualifiés et régulièrement formés.'},{icon:'shield',title:'Un service transparent',text:'Des devis clairs et une facturation adaptée à votre structure.'},{icon:'people',title:'Une relation de confiance',text:'Un accompagnement personnalisé pour chaque client.'},{icon:'leaf',title:'Un engagement local',text:'Un garage indépendant, ancré dans la région de Poissy.'}] %}<article><span>{{ icons.svg(item.icon) }}</span><div><strong>{{ item.title }}</strong><p>{{ item.text }}</p></div></article>{% endfor %}</section>
<section class="garage-story"><article><h2>Notre histoire</h2><p>Depuis plus de 10 ans, Horizon Auto accompagne les particuliers et les professionnels dans l’entretien et la réparation de leurs véhicules.</p><p>Notre objectif : offrir un service fiable, réactif et de qualité, avec une attention particulière à la satisfaction de nos clients.</p><a class="btn btn-outline-dark" href="{{ path('contact') }}">Nous contacter →</a></article><ol class="garage-timeline"><li><b>2013</b><span>Création du garage à Poissy</span></li><li><b>2016</b><span>Agrandissement de l’atelier</span></li><li><b>2020</b><span>Développement de l’activité véhicules d’occasion</span></li><li><b>2024</b><span>Un service toujours plus complet pour nos clients</span></li></ol><aside><h2>Nos valeurs</h2><ul><li>{{ icons.svg('shield') }} Qualité</li><li>{{ icons.svg('people') }} Proximité</li><li>{{ icons.svg('leaf') }} Transparence</li><li>{{ icons.svg('wrench') }} Engagement</li><li>{{ icons.svg('star') }} Satisfaction client</li></ul></aside></section>
</div><section class="garage-team"><div class="container"><h2>Une équipe à votre service</h2><p>Des professionnels passionnés et à l’écoute de vos besoins.</p><div>{% for membre in membres_equipe %}<article>{% if membre.photo %}<img src="{{ asset(membre.photo) }}" alt="{{ membre.nom }}" width="52" height="52" loading="lazy">{% else %}<span>{{ icons.svg('people') }}</span>{% endif %}<div><strong>{{ membre.nom }}</strong><p>{{ membre.fonction }}</p></div></article>{% else %}<div class="empty-state">L’équipe sera bientôt présentée ici.</div>{% endfor %}</div></div></section></main>
{% endblock %}
