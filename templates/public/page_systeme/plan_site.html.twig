{% extends 'base.html.twig' %}
{% block title %}Plan du site — {{ parent() }}{% endblock %}
{% block body %}
    {% include 'components/_breadcrumb.html.twig' with {items: [{label: 'Accueil', url: path('accueil')}, {label: 'Plan du site'}]} %}
    <section class="section-space"><div class="container"><h1>Plan du site</h1><div class="row g-4 mt-2"><div class="col-md-6"><h2 class="h4">Pages principales</h2><ul><li><a href="{{ path('accueil') }}">Accueil</a></li><li><a href="{{ path('prestations_index') }}">Prestations</a></li><li><a href="{{ path('vehicules_index') }}">Véhicules d’occasion</a></li><li><a href="{{ path('professionnels') }}">Professionnels</a></li><li><a href="{{ path('garage') }}">À propos</a></li><li><a href="{{ path('faq') }}">Questions fréquentes</a></li><li><a href="{{ path('contact') }}">Contact et accès</a></li><li><a href="{{ path('rendez_vous') }}">Prendre rendez-vous</a></li></ul></div><div class="col-md-6"><h2 class="h4">Informations légales</h2><ul><li><a href="{{ path('mentions_legales') }}">Mentions légales</a></li><li><a href="{{ path('politique_confidentialite') }}">Politique de confidentialité</a></li><li><a href="{{ path('declaration_accessibilite') }}">Accessibilité</a></li></ul></div>
        <div class="col-md-6"><h2 class="h4">Prestations</h2><ul>{% for prestation in prestations %}<li><a href="{{ path('prestation_detail', {slug: prestation.slug}) }}">{{ prestation.nom }}</a></li>{% else %}<li>Aucune prestation publiée.</li>{% endfor %}</ul></div><div class="col-md-6"><h2 class="h4">Véhicules</h2><ul>{% for vehicule in vehicules %}<li><a href="{{ path('vehicule_detail', {reference: vehicule.reference}) }}">{{ vehicule.titre }}</a></li>{% else %}<li>Aucun véhicule publié.</li>{% endfor %}</ul></div>{% if pages_locales|length > 0 %}<div class="col-md-6"><h2 class="h4">Garages automobiles à proximité</h2><ul>{% for page in pages_locales %}<li><a href="{{ path('page_locale_detail', {commune: page.slug}) }}">{{ page.titre }}</a></li>{% endfor %}</ul></div>{% endif %}</div></div></section>
{% endblock %}
