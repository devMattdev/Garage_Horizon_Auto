{% extends 'base.html.twig' %}
{% import 'components/_icons.html.twig' as icons %}
{% set site = parametres_site() %}
{% block title %}Garage automobile à {{ site.ville ?: 'Poissy' }} — {{ site.raisonSociale ?: 'Horizon Auto' }}{% endblock %}
{% block body %}
    <section class="hero-photo">
        <picture>
            <source type="image/webp" srcset="{{ asset('images/img-accueil/hero-atelier-640.webp') }} 640w, {{ asset('images/img-accueil/hero-atelier-960.webp') }} 960w, {{ asset('images/img-accueil/hero-atelier-1600.webp') }} 1600w" sizes="100vw">
            <img class="hero-photo__media" src="{{ asset('images/img-accueil/hero-atelier-1600.jpg') }}" srcset="{{ asset('images/img-accueil/hero-atelier-640.jpg') }} 640w, {{ asset('images/img-accueil/hero-atelier-960.jpg') }} 960w, {{ asset('images/img-accueil/hero-atelier-1600.jpg') }} 1600w" sizes="100vw" alt="Mécanicien effectuant un entretien moteur dans l’atelier {{ site.raisonSociale ?: 'Horizon Auto' }}" width="1600" height="683" loading="eager" fetchpriority="high">
        </picture>
        <div class="hero-photo__scrim" aria-hidden="true"></div>
        <div class="hero-photo__content"><div class="container">
            <p class="hero__eyebrow">Garage automobile à {{ site.ville ?: 'Poissy' }}</p>
            <h1>Votre garage de confiance<br><span>à {{ site.ville ?: 'Poissy' }}</span></h1>
            <p class="hero__lead mt-3">Entretien, réparation et diagnostic automobile pour particuliers et professionnels.</p>
            <div class="badge-row mt-4">
                <span class="badge-row__item">{{ icons.svg('check') }}Toutes marques</span>
                <span class="badge-row__item">{{ icons.svg('check') }}Devis avant intervention</span>
                <span class="badge-row__item">{{ icons.svg('check') }}Véhicule de courtoisie</span>
                <span class="badge-row__item">{{ icons.svg('check') }}QualiRépar</span>
            </div>
            <div class="d-flex flex-wrap gap-3 mt-4">
                <a class="btn btn-primary btn-lg" href="{{ path('rendez_vous') }}">{{ icons.svg('calendar') }} Demander un rendez-vous</a>
                {% if site.telephone %}<a class="btn btn-outline-light btn-lg" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}
            </div>
        </div></div>
    </section>

    <section class="section-space section-space--soft py-4"><div class="container"><div class="row g-3">
        {% for famille in [
            {valeur: 'entretien', libelle: 'Révision / Vidange', sous_titre: 'À partir de 89 €', icone: 'home-oil'},
            {valeur: 'mecanique', libelle: 'Distribution', sous_titre: 'Notre prestation la plus rentable', icone: 'home-distribution'},
            {valeur: 'controle_technique', libelle: 'Freinage', sous_titre: 'Sécurité avant tout', icone: 'home-brake'},
            {valeur: 'pneumatique', libelle: 'Pneumatiques', sous_titre: 'Vente et montage', icone: 'home-tire'},
            {valeur: 'climatisation', libelle: 'Climatisation', sous_titre: 'Entretien et recharge', icone: 'home-snow'},
            {valeur: 'diagnostic', libelle: 'Diagnostic électronique', sous_titre: 'Toutes marques', icone: 'home-engine'},
        ] %}
        <div class="col-6 col-lg-2"><a class="service-tile text-decoration-none h-100" href="{{ path('prestations_index', {famille: famille.valeur}) }}"><span class="icon-circle">{{ icons.svg(famille.icone) }}</span><strong>{{ famille.libelle }}</strong><span>{{ famille.sous_titre }}</span></a></div>
        {% endfor %}
    </div></div></section>

    {% if vehicules|length > 0 %}<section class="section-space section-space--soft" aria-labelledby="occasions"><div class="container"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 section-heading mw-100"><div><p class="section-eyebrow">En stock</p><h2 id="occasions">Véhicules d’occasion</h2></div><a href="{{ path('vehicules_index') }}">Voir tout le stock</a></div><div class="row g-4">{% for vehicule in vehicules|slice(0, 3) %}<div class="col-md-6 col-lg-4">{% include 'components/_vehicle_card.html.twig' with {vehicule: vehicule} only %}</div>{% endfor %}</div></div></section>{% endif %}

    <section class="home-trust" aria-labelledby="pourquoi"><div class="container-fluid px-xl-4"><div class="row g-3 align-items-stretch">
        <div class="col-lg-4">
            <picture class="why-choose__photo-wrap">
                <source type="image/webp" srcset="{{ asset('images/img-accueil/devanture-garage-500.webp') }} 500w, {{ asset('images/img-accueil/devanture-garage-700.webp') }} 700w, {{ asset('images/img-accueil/devanture-garage-1000.webp') }} 1000w" sizes="(min-width: 992px) 33vw, 100vw">
                <img class="why-choose__photo" src="{{ asset('images/img-accueil/devanture-garage-700.jpg') }}" srcset="{{ asset('images/img-accueil/devanture-garage-500.jpg') }} 500w, {{ asset('images/img-accueil/devanture-garage-700.jpg') }} 700w, {{ asset('images/img-accueil/devanture-garage-1000.jpg') }} 1000w" sizes="(min-width: 992px) 33vw, 100vw" alt="Devanture du garage {{ site.raisonSociale ?: 'Horizon Auto' }}" width="1000" height="563" loading="lazy">
            </picture>
        </div>
        <div class="col-lg-4 home-trust__reasons">
            <h2 id="pourquoi" class="h4 mb-4">Pourquoi choisir Horizon Auto&nbsp;?</h2>
            <div class="why-choose">
                <div class="why-choose__item"><span class="icon-circle">{{ icons.svg('people') }}</span><div><strong>Garage indépendant</strong><p>Un service personnalisé et de proximité.</p></div></div>
                <div class="why-choose__item"><span class="icon-circle">{{ icons.svg('badge') }}</span><div><strong>Certifié QualiRépar</strong><p>Un gage de qualité et de confiance.</p></div></div>
                <div class="why-choose__item"><span class="icon-circle">{{ icons.svg('shield') }}</span><div><strong>Partenariat contrôle technique</strong><p>Un centre agréé à proximité.</p></div></div>
                <div class="why-choose__item"><span class="icon-circle">{{ icons.svg('document') }}</span><div><strong>Conseils et transparence</strong><p>Des explications claires et un devis avant intervention.</p></div></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="sidebar-card">
                <h2 class="h5">{{ icons.svg('clock') }}Horaires d’ouverture</h2>
                {% for groupe in horaires_groupes() %}<div class="sidebar-card__row"><span>{{ groupe.jours }}</span><strong>{% for segment in groupe.horaires|split(' / ') %}{{ segment }}{% if not loop.last %}<br>{% endif %}{% endfor %}</strong></div>{% endfor %}
                {% if fermetures|length > 0 %}{% set fermeture = fermetures[0] %}<div class="sidebar-card__closure">{{ icons.svg('calendar') }}<span><strong>{{ fermeture.libelle }}</strong><br>Du {{ fermeture.debutLe|date('d/m/Y') }} au {{ fermeture.finLe|date('d/m/Y') }}</span></div>{% endif %}
                <div class="mt-3 d-grid gap-2">
                    {% if site.telephone %}<a class="btn btn-primary" href="tel:{{ telephone_uri(site.telephone) }}">{{ icons.svg('phone') }} {{ site.telephone }}</a>{% endif %}
                </div>
                {% if site.urlFicheGoogle %}<a class="sidebar-card__link mt-3" href="{{ site.urlFicheGoogle }}">{{ icons.svg('pin') }} Voir l’itinéraire {{ icons.svg('chevron-right') }}</a>{% endif %}
            </div>
        </div>
    </div></div></section>

    {% if questions|length > 0 %}<section class="section-space section-space--soft" aria-labelledby="questions"><div class="container"><div class="section-heading"><p class="section-eyebrow">Pratique</p><h2 id="questions">Questions fréquentes</h2></div><div class="faq-list">{% for question in questions %}<details><summary>{{ question.question }}</summary><div>{{ question.reponse|nl2br }}</div></details>{% endfor %}</div><a class="btn btn-outline-primary mt-4" href="{{ path('faq') }}">Toutes les questions</a></div></section>{% endif %}

{% endblock %}
