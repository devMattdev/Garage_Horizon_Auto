# Garage Horizon Auto — overrides charges UNIQUEMENT dans le conteneur "php"
# de docker-compose.yaml (via env_file), en plus de .env / .env.dev / .env.local.
#
# Objectif : depuis l'hote (PHP local, wamp, IDE...), DATABASE_URL de .env pointe
# vers 127.0.0.1:3306, qui correspond au port publie par le service "mysql" de
# docker-compose.yaml. Mais DEPUIS le conteneur "php", "127.0.0.1" designerait le
# conteneur lui-meme, pas la base : il faut donc utiliser le nom du service Docker
# ("mysql") comme hote. Ce fichier ne redefinit que cette valeur ; le reste
# (identifiants, base "app") reste identique a .env pour correspondre au service
# mysql de docker-compose.yaml.
DATABASE_URL="mysql://app:!ChangeMe!@mysql:3306/app?serverVersion=8.4.0&charset=utf8mb4"

# Idem pour Mailpit si un service de capture de mails est ajoute ulterieurement :
# MAILER_DSN=smtp://mailer:1025
